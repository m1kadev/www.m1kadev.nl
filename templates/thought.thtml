<!DOCTYPE html>
<html lang="en-GB">

<head>

    {{ &base_header }}

    <link rel="stylesheet" href="/styles/thought.css">

    <title> {{ name }} - m1kadev</title>

    {{ &ogp }}

</head>

<body>

    {{ &navbar }}

    <div id="content">
        <main>
            <h2> {{ name }} </h2>
            <span id="thought">
                {{ thought }}
            </span>
            <small>-mika, {{ date }}</small>
            <hr>
            {{ &footer }}
        </main>
    </div>

</body>

</html>